FROM ghcr.io/astral-sh/uv:python3.13-trixie AS builder

ARG LIBHEIF_VERSION=1.23.4
ARG LIBHEIF_SHA256=d0c02b4b0e978f34a1974b6f3eea7975a537bf7a9195ffeea38e7242ff316fdd
ARG PI_HEIF_VERSION=1.7.0.post1

WORKDIR /src

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-suggests --no-install-recommends -y \
        binutils build-essential cmake curl libde265-dev pkg-config unzip \
    && curl -fsSLo /tmp/libheif.tar.gz \
        "https://github.com/strukturag/libheif/releases/download/v${LIBHEIF_VERSION}/libheif-${LIBHEIF_VERSION}.tar.gz" \
    && echo "${LIBHEIF_SHA256}  /tmp/libheif.tar.gz" | sha256sum -c - \
    && mkdir /tmp/libheif-src \
    && tar -xzf /tmp/libheif.tar.gz -C /tmp/libheif-src --strip-components=1 \
    && cmake -S /tmp/libheif-src -B /tmp/libheif-build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DENABLE_PLUGIN_LOADING=OFF \
        -DWITH_LIBDE265=ON \
        -DWITH_LIBDE265_PLUGIN=OFF \
        -DWITH_X265=OFF \
        -DWITH_X265_PLUGIN=OFF \
        -DWITH_X264=OFF \
        -DWITH_AOM_DECODER=OFF \
        -DWITH_AOM_ENCODER=OFF \
        -DWITH_DAV1D=OFF \
        -DWITH_OpenH264_DECODER=OFF \
        -DWITH_OpenH264_ENCODER=OFF \
        -DWITH_LIBSHARPYUV=OFF \
        -DWITH_EXAMPLES=OFF \
        -DWITH_GDK_PIXBUF=OFF \
        -DBUILD_DOCUMENTATION=OFF \
        -DBUILD_TESTING=OFF \
    && cmake --build /tmp/libheif-build --parallel "$(nproc)" \
    && DESTDIR=/tmp/libheif-package cmake --install /tmp/libheif-build \
    && cmake --install /tmp/libheif-build \
    && rm -rf /tmp/libheif-package/usr/include \
        /tmp/libheif-package/usr/lib/*/pkgconfig \
        /tmp/libheif-package/usr/lib/pkgconfig \
    && mkdir -p /tmp/libheif-package/DEBIAN \
        /tmp/libheif-package/usr/share/doc/libheif1 \
        /out \
    && cp /tmp/libheif-src/COPYING /tmp/libheif-package/usr/share/doc/libheif1/copyright \
    && printf '%s\n' \
        'Package: libheif1' \
        "Version: ${LIBHEIF_VERSION}-1~piheif1" \
        "Architecture: $(dpkg --print-architecture)" \
        'Maintainer: Peter Stolz <github@peterstolz.de>' \
        'Depends: libde265-0 (>= 1.0.11)' \
        'Section: libs' \
        'Priority: optional' \
        'Homepage: https://github.com/strukturag/libheif' \
        'Description: decoder-only libheif shared library for pi-heif' \
        ' Built without encoder codecs and packaged explicitly for SBOM scanners.' \
        > /tmp/libheif-package/DEBIAN/control \
    && dpkg-deb --build --root-owner-group /tmp/libheif-package \
        "/out/libheif1_${LIBHEIF_VERSION}-1~piheif1_$(dpkg --print-architecture).deb"

# Keep source changes out of the expensive native-library cache key.
COPY . .

RUN cp -a pi-heif/. . \
    && python3 .github/transform_to-pi_heif.py \
    && sed -i "s/__version__ = \"1.7.0\"/__version__ = \"${PI_HEIF_VERSION}\"/" pi_heif/_version.py \
    && uv build --wheel --out-dir /out \
    && mkdir /tmp/pi-heif-wheel \
    && unzip -q /out/pi_heif-*.whl -d /tmp/pi-heif-wheel \
    && readelf -d /tmp/pi-heif-wheel/_pi_heif*.so | grep 'Shared library: \[libheif.so.1\]' \
    && test ! -d /tmp/pi-heif-wheel/pi_heif.libs \
    && sha256sum /out/* > /out/SHA256SUMS

FROM scratch AS artifact
COPY --from=builder /out /
